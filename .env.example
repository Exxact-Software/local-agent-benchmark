# Copy this to .env and fill in your values
# cp .env.example .env

# Host Ollama URL — the benchmark container reaches it via network_mode: host.
# If you've moved Ollama to another machine, change this to that host's URL.
OLLAMA_HOST=http://localhost:11434

# SearXNG URL — used only when running with --live-tools
# Start the container with: docker compose up -d searxng
SEARXNG_URL=http://localhost:8080

# Google Maps Platform (for live tool mode — geocode, places, directions, parking)
# Get a key at https://console.cloud.google.com — enable Maps, Places, Directions APIs
# Leave blank to use mock data for these tools (default)
GOOGLE_MAPS_API_KEY=
